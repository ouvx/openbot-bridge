# Empty until scripts/setup.mjs generates a fresh random passcode.
BRIDGE_ADMIN_SECRET=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8790
BRIDGE_READ_ONLY=1
BRIDGE_EXTENDED_TOOLS=0
BRIDGE_EVENTS=0
# Empty list exposes no individual agents.
BRIDGE_ALLOWED_AGENT_IDS=
BRIDGE_CLIENT_AGENT_IDS={}
BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:8790
BRIDGE_PUBLIC_URL=
BRIDGE_DATA_DIR=./data
BRIDGE_LOG_LEVEL=info
BRIDGE_APPROVAL_TTL_SECONDS=120
BRIDGE_WRITES_PER_MINUTE=12
BRIDGE_GLOBAL_WRITES_PER_MINUTE=60
BRIDGE_APPROVALS_PER_GRANT_PER_MINUTE=8
BRIDGE_GLOBAL_APPROVALS_PER_MINUTE=40

# Notifications are off unless all of the following are valid.
BRIDGE_NOTIFY=off
BRIDGE_NOTIFY_WEBHOOK_URL=
BRIDGE_NOTIFY_SECRET_FILE=
# Tests only: allow plain HTTP to 127.0.0.1 / [::1].
BRIDGE_NOTIFY_ALLOW_LOOPBACK_HTTP=0
BRIDGE_NOTIFY_TIMEOUT_MS=3000
